# ────────────────────────────────────────────────
# Puerto Rico AI Battle Platform — EC2 backend env
# Copy this file to `.env` on EC2 for backend + Caddy only.
# Frontend-only `VITE_*` variables belong in Vercel, not on the EC2 host.
# Optional helper: python3 backend/scripts/build_ec2_env.py --source .env --output .env.ec2
# ────────────────────────────────────────────────

# ── Database / Redis ───────────────────────────
POSTGRES_USER=puco_user
POSTGRES_PASSWORD=change-me-strong-db-password
REDIS_PASSWORD=change-me-strong-redis-password

# ── Public backend routing ─────────────────────
# Use an Elastic IP-backed hostname so Google/Vercel/Caddy settings stay stable.
PUBLIC_BACKEND_HOST=3.38.63.58.sslip.io
ALLOWED_ORIGINS=https://puco-test.vercel.app

# ── App security ───────────────────────────────
SECRET_KEY=change-me-generate-a-random-64-char-hex-string
INTERNAL_API_KEY=change-me-generate-a-random-64-char-hex-string

# ── Runtime / deploy mode ──────────────────────
APP_LOG_DIR=/tmp/castone-data/logs
DEBUG=false
REPLAY_STORAGE_BACKEND=db
BACKEND_IMAGE_TAG=prod

# ── Bot serving ────────────────────────────────
MODEL_TYPE=ppo
PPO_MODEL_FILENAME=
HPPO_MODEL_FILENAME=
PPO_BUNDLE_DIR=ppo-pr-server-semantic293-20260419

# ── Google OAuth ───────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Vercel-only vars (set in Vercel dashboard) ─
# VITE_BACKEND_ORIGIN=https://3.38.63.58.sslip.io
# VITE_GOOGLE_CLIENT_ID=<same value as GOOGLE_CLIENT_ID>
# VITE_INTERNAL_API_KEY=<same value as INTERNAL_API_KEY>
