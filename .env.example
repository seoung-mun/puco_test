# ────────────────────────────────────────────────
# Puerto Rico AI Battle Platform — Environment Variables
# Copy this file to .env and fill in the values.
# Optional helper: python3 backend/scripts/bootstrap_env_secrets.py --env-file .env
# ────────────────────────────────────────────────

# ── Database (PostgreSQL) ──────────────────────
POSTGRES_USER=puco_user
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://puco_user:change-me-strong-db-password@db:5432/puco_rl

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/0

# ── Frontend → Backend proxy ───────────────────
# In Docker prod: leave empty (nginx handles routing)
# In local dev: http://localhost:8000
VITE_API_TARGET=

# Split frontend/backend deployment (for example Vercel frontend + Render backend).
# Leave empty when the frontend and backend share the same origin through a reverse proxy.
VITE_BACKEND_ORIGIN=http://localhost:8000

# Optional log directory override.
APP_LOG_DIR=/tmp/castone-data/logs

# Replay payload storage backend.
# Hosted deployments use db-backed replay persistence.
REPLAY_STORAGE_BACKEND=db

# ── Security ───────────────────────────────────
# REQUIRED in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-char-hex-string

# REQUIRED for Legacy API write endpoints (X-API-Key header).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=change-me-generate-a-random-64-char-hex-string
VITE_INTERNAL_API_KEY=change-me-same-value-as-INTERNAL_API_KEY

# ── CORS ───────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:5173

# ── Debug mode ─────────────────────────────────
# Set to "true" ONLY in local development.
# Enables /api/v1/auth/mock-login endpoint.
DEBUG=false

# ── Bot model ──────────────────────────────────
# MODEL_TYPE selects the agent architecture:
#   ppo  → PPO Agent (bundle-first via PPO_BUNDLE_DIR)
#   hppo → HierarchicalPPO Agent (uses HPPO_MODEL_FILENAME)
# Must match the architecture used during training.
MODEL_TYPE=ppo

# Bundle-first serving for PPO. Leave PPO_MODEL_FILENAME empty in production
# unless you intentionally want a legacy non-bundle checkpoint fallback.
PPO_MODEL_FILENAME=
HPPO_MODEL_FILENAME=
PPO_BUNDLE_DIR=ppo-pr-server-semantic293-20260419

# ── Google OAuth ───────────────────────────────
# REQUIRED for Google Sign-In.
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Add your frontend origin (e.g. http://localhost:3000) as an Authorized JavaScript origin.
# If teammates access the app through a different host/IP/domain, add that exact origin too.
# If the OAuth consent screen is in Testing mode, every teammate Google account must be added to Test users.
#
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
